# Reverse-proxy для выхода IvaMaris TDO в интернет.
# DOMAIN берётся из .env (docker-compose.prod.yml). Caddy сам получает и
# продлевает TLS-сертификат Let's Encrypt — нужен только A-запись DNS на сервер
# и открытые 80/443.

{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	# Внутренняя система — не для публичной индексации/сканирования.
	# Известные поисковые/AI-краулеры и массовые сканеры отсекаем по UA ДО
	# прокси на бэкенд/фронт (они не тратят наши ресурсы вообще). ВАЖНО:
	# это должен быть именно `handle`, а не голый `respond` — `handle`-блоки
	# в Caddy обрабатываются по порядку и терминальны, поэтому этот блок
	# обязан идти ПЕРЕД остальными handle-блоками ниже, иначе catch-all
	# `handle {}` перехватит запрос раньше, чем сработает блокировка.
	# X-Robots-Tag выше — вежливая просьба индексаторам не индексировать,
	# даже если кто-то доберётся с незнакомым UA. Это снижает шум/индексацию,
	# НЕ заменяет авторизацию как защиту доступа.
	@bots header_regexp UA User-Agent "(?i)bot|crawl|spider|slurp|bingpreview|facebookexternalhit|semrush|ahrefs|mj12bot|dotbot|petalbot|yandexbot|googlebot|bytespider|gptbot|ccbot|claudebot|scrapy|masscan|nmap|nikto|zgrab|censys|shodan"
	handle @bots {
		respond 403
	}

	# API → backend. Фронт ходит на относительный /api (VITE_API_URL пустой),
	# поэтому CORS и mixed-content исключены by design.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Всё остальное → frontend.
	handle {
		reverse_proxy frontend:3000
	}
}
