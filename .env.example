# Database
POSTGRES_USER=tdo_app
POSTGRES_PASSWORD=change-this-to-long-random-password-32-plus
POSTGRES_DB=tdms
DATABASE_URL=postgresql+psycopg://tdo_app:change-this-to-long-random-password-32-plus@db:5432/tdms

# Окружение: production включает проверку секретов при старте (backend
# откажется запускаться с дефолтным SECRET_KEY/паролем админа).
APP_ENV=development
# Публичный домен для выхода в интернет (Caddy/TLS, docker-compose.prod.yml).
DOMAIN=

# Security
SECRET_KEY=change-this-to-long-random-secret-key-64-plus
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Bootstrap admin
FIRST_ADMIN_EMAIL=admin@ivamaris.io
FIRST_ADMIN_PASSWORD=change-this-admin-password
# Аварийный сброс пароля/прав админа к значениям выше при старте backend.
# По умолчанию false: рестарты и обновления НЕ трогают пароль, изменённый в UI.
# Забыли пароль → true, перезапустить backend, войти, вернуть false.
FORCE_ADMIN_RESET=false
FIRST_ADMIN_FULL_NAME=System Administrator
MAIN_ADMIN_EMAIL=admin@ivamaris.io
SEED_DEMO_USERS=false

# Frontend API URL
VITE_API_URL=http://localhost:8000

# MinIO
MINIO_ROOT_USER=tdo_minio
MINIO_ROOT_PASSWORD=change-this-minio-password-32-plus

# --- Хранилища DCC (документы/ревизии) ---
# Должны лежать на persistent volume, иначе PDF теряются при пересборке.
# По умолчанию совпадают с томами в docker-compose. Можно переопределить на
# host bind-mount (см. SYSADMIN_DEPLOY_RU §9) для надёжности и бэкапов.
TDO_UPLOADS_ROOT=/tmp/tdo_uploads
SMART_UPLOAD_ROOT=/tmp/tdo_smart_upload

# --- Модуль Vendors (VQM) ---
# Корпоративный SMTP для email-кодов подтверждения подрядчиков.
# Если SMTP_HOST пуст — письма не отправляются, код пишется в backend-лог
# (режим разработки). Для прода заполнить обязательно.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ivamaris.io
SMTP_USE_TLS=true
# Отключить проверку SSL-сертификата SMTP (для self-signed корп. сертификата).
# Слабый DH-ключ сервера (ошибка DH_KEY_TOO_SMALL) обрабатывается автоматически.
SMTP_INSECURE=false
# Имя, которым backend представляется в EHLO/HELO. БЕЗ него Python подставит
# внутренний docker-IP (172.x), и корп. Exchange отклонит сессию. Указать
# hostname или IP ХОСТОВОЙ машины (не docker), например:
SMTP_HELO=192.168.11.237

# Базовый URL фронта для ссылок-приглашений в письмах (БЕЗ trailing slash).
# На проде — реальный HTTPS-домен, например https://tdo.company.ru
PUBLIC_BASE_URL=http://localhost:3000

# --- Модуль FEED: AI-поиск / RAG-агент ---
# OpenAI-совместимый API — «мозг» агента и LLM. Для OpenRouter:
AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=qwen-plus                              # legacy keyword-AI; агент берёт AGENT_MODEL

# RAG-агент (LangGraph + Qdrant + локальные эмбеддинги bge-m3).
# Эмбеддинги считаются ЛОКАЛЬНО (опенсорс, данные не уходят наружу).
# Первый запуск качает модель bge-m3 (~2GB ONNX), держит ~2GB RAM.
QDRANT_URL=http://qdrant:6333                   # ":memory:" — эфемерно (dev)
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_RERANK=true
AGENT_MODEL=qwen/qwen-2.5-72b-instruct:free     # модель ответа на OpenRouter
# Включить умный поиск: тумблер «Умный поиск» в FEED (под админом),
# затем POST /api/v1/feed/agent/reindex — построить векторный индекс.
